# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Notion integration (server)
NOTION_TOKEN="secret_xxx"
# Optional alias for NOTION_TOKEN (new Notion key often starts with ntn_)
NOTION_API_KEY=""
NOTION_DB_COURSES_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_DB_PROJECTS_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NOTION_API_VERSION="2022-06-28"
# Optional alias for NOTION_API_VERSION
NOTION_VERSION=""
BASE_URL="https://your-railway-app.up.railway.app"
REVALIDATE_SECRET="optional-secret"
COURSE_LINK_SYNC_SECRET="set-a-strong-shared-secret"
API_BASE_URL="http://localhost:8787"

# Supabase (server)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"
# Optional legacy alias (prefer SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=""
READ_FROM_SUPABASE="false"

# Cloudflare R2 (server, image sync)
IMAGE_BACKEND="r2"
IMAGE_SYNC_ENABLED="false"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Development: https://<bucket-hash>.r2.dev
# Production: https://media.your-domain.com
R2_PUBLIC_BASE_URL=""
# Optional explicit S3 endpoint; default uses https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=""
