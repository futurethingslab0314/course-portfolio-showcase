{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "noEmit": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "src/types.ts"]
}
